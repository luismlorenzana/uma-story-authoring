{
  "name": "uma-story-authoring",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --no-warnings --experimental-strip-types --import tsx hub.mjs",
    "publish": "node --import tsx publishing/push.ts",
    "pull": "node --import tsx publishing/pull.ts",
    "test": "node --experimental-strip-types --no-warnings --test quest/lib/*.test.mjs farm/lib/*.test.mjs cyberpunk/lib/*.test.mjs && vitest run publishing"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
